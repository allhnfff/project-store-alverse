 "faq": [
  {
   "q": "Berapa lama prosesnya?",
   "a": "Biasanya cepat setelah order dikonfirmasi di WhatsApp. Untuk jasa desain/joki, waktunya tergantung tingkat kesulitan dan deadline."
  },
  {
   "q": "Ada garansi?",
   "a": "Ada untuk beberapa produk sesuai ketentuan. Tanyakan ke admin untuk detail garansi tiap produk."
  },
  {
   "q": "Metode pembayarannya apa saja?",
   "a": "Silakan chat admin untuk info metode pembayaran yang tersedia."
  },
  {
   "q": "Akun sharing dan private bedanya apa?",
   "a": "Sharing dipakai bersama sesuai paket. Private khusus untuk kamu. Detailnya bisa berbeda tiap layanan, jadi konfirmasi dulu ke admin."
  },
  {
   "q": "Cara order lewat bot gimana?",
   "a": "Klik Order via bot, kirim LIST, lalu pilih nomor produk. Bot akan mengirim detail dan cara belinya."
  }
